rules_version = '2';

// SpareKG Firestore rules.
//
// Guiding rule (blueprint §4.4): the client may read what concerns it and may
// edit only descriptive fields it owns. Every mutation that moves money, points,
// status or capacity goes through a Cloud Function, which runs with Admin SDK
// credentials and bypasses this file entirely. So "deny" here is the default and
// the safe answer — a denied client write means "call the callable instead".
//
// Note on queries: rules are filters only for `get`, never for `list`. A list
// query is rejected unless its constraints prove every matching document is
// readable. That is why the bid queries in src/lib/store/api.ts always pin
// senderId or travelerId to the caller.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }

    // Fields the client is changing on an update.
    function touched() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /users/{userId} {
      // Own document only. The user record holds phone numbers and payout
      // details, and §9 is explicit that contact details stay hidden until a bid
      // is AGREED — so this must not be readable by every signed-in user.
      //
      // Nothing is lost by this: flights and bids each carry a denormalized
      // block (name, photo, rating, trip count) precisely so the UI can show a
      // counterparty without reading their profile.
      allow read: if isOwner(userId) || isAdmin();

      // Created by the onUserCreate trigger, not the client.
      allow create: if false;

      // Allowlist, not a blocklist. A blocklist silently grants write access to
      // every field added to the schema later — including balances and ratings.
      allow update: if isOwner(userId)
        && touched().hasOnly([
          'displayName', 'photoUrl', 'phone',
          'preferredLanguage', 'homeAirportCode', 'lastActiveAt',
          'spokenLanguages', 'payoutDetails'
        ]);

      allow delete: if false;
    }

    match /flights/{flightId} {
      allow read: if isSignedIn();

      // postFlight owns creation: it sets status, capacity and the denormalized
      // traveler block, none of which the client may choose.
      allow create: if false;

      // The traveler may correct the listing's descriptive copy while it is still
      // open. Everything that affects matching or money is server-only.
      allow update: if isOwner(resource.data.travelerId)
        && resource.data.status in ['DRAFT', 'LIVE']
        && touched().hasOnly(['specialNotes', 'acceptedCategories', 'prohibitedItems', 'updatedAt']);

      allow delete: if false;
    }

    match /bids/{bidId} {
      // Only the two parties. Rival senders must not see each other's offers —
      // that is both commercially sensitive and a nudge toward off-platform deals.
      allow read: if isOwner(resource.data.senderId)
        || isOwner(resource.data.travelerId)
        || isAdmin();

      // submitBid / acceptBid / declineBid own the whole lifecycle. A client that
      // could write here could set its own price or accept its own bid.
      allow write: if false;
    }

    match /points_ledger/{entryId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /transactions/{txId} {
      allow read: if isOwner(resource.data.travelerId)
        || isOwner(resource.data.senderId)
        || isAdmin();
      allow write: if false;
    }

    match /audit_log/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Display-only mirror of who holds staff access, so the console can list
    // team members — custom claims are the real authority and are not queryable.
    // Never read this to make an authorisation decision.
    match /admin_roles/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // kyc_submissions is intentionally absent: it is written and read solely by
    // server actions using the Admin SDK, so it falls through to the deny-all
    // below. Identity documents should never be client-readable.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
